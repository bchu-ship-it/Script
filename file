            if (gravityDir === 1) x -= 5;
            if (gravityDir === 2) y -= 5;
            if (gravityDir === 3) x += 5;
        }
        
        if (k === 'r') {
            x = 50;
            y = 20;
            vx = 0;
            vy = 0;
            fuel = 100;
            gravityDir = 0;
            jetpackEquipped = false;
        }
    });

    window.addEventListener('keyup', e => {
        keys[e.key.toLowerCase()] = false;
    });

    // Main Game Loop
    setInterval(() => {
        // Read directional controls relative to screenspace
        const moveLeft = keys['a'] || keys['arrowleft'];
        const moveRight = keys['d'] || keys['arrowright'];
        const moveUp = keys['w'] || keys['arrowup'] || keys[' '];

        // Horizontal axis movement relative to current gravity vector
        if (gravityDir === 0 || gravityDir === 2) {
            const sideDir = gravityDir === 0 ? 1 : -1;
            if (moveLeft) {
                vx = -5.5 * sideDir;
                tilt += ((-6 * sideDir) - tilt) * 0.2;
                if (og && Math.random() > 0.3) fx(x, y, 'trail');
            } else if (moveRight) {
                vx = 5.5 * sideDir;
                tilt += ((6 * sideDir) - tilt) * 0.2;
                if (og && Math.random() > 0.3) fx(x, y, 'trail');
            } else {
                vx *= 0.72;
                tilt += (0 - tilt) * 0.15;
            }
        } else { // gravityDir is 1 (Left) or 3 (Right)
            const sideDir = gravityDir === 1 ? 1 : -1;
            if (moveLeft) { // relative up in screen coordinates
                vy = -5.5 * sideDir;
                tilt += ((-6 * sideDir) - tilt) * 0.2;
                if (og && Math.random() > 0.3) fx(x, y, 'trail');
            } else if (moveRight) { // relative down in screen coordinates
                vy = 5.5 * sideDir;
                tilt += ((6 * sideDir) - tilt) * 0.2;
                if (og && Math.random() > 0.3) fx(x, y, 'trail');
            } else {
                vy *= 0.72;
                tilt += (0 - tilt) * 0.15;
            }
        }

        // Thrust Mechanics handling gravity directions
        isThrusting = false;
        const wantsThrust = jetpackEquipped || (moveUp && !og);
        
        if (wantsThrust && fuel > 0) {
            if (gravityDir === 0) vy = -6.5;
            if (gravityDir === 1) vx = 6.5;
            if (gravityDir === 2) vy = 6.5;
            if (gravityDir === 3) vx = -6.5;
            
            fuel -= 1.5;
            isThrusting = true;
            sx = 0.8;
            sy = 1.2;
            if (Math.random() > 0.2) fx(x, y, 'jetpack');
        }

        if (fuel <= 0) {
            jetpackEquipped = false;
        }

        // Apply constant gravity vector forces
        if (gravityDir === 0) vy += 0.65;
        if (gravityDir === 1) vx -= 0.65;
        if (gravityDir === 2) vy -= 0.65;
        if (gravityDir === 3) vx += 0.65;

        x += vx;
        y += vy;

        if (dropTimer > 0) dropTimer--;

