        b.style.transform = '';
        b.style.transition = '';
    };

    // Particle Effects Engine
    function fx(tx, ty, type) {
        const count = type === 'land' ? 12 : (type === 'jetpack' ? 2 : 4);
        for (let i = 0; i < count; i++) {
            const s = d.createElement('div');
            let ang, spd;

            if (type === 'jetpack') {
                // Jetpack particles always shoot opposite to current gravity
                const baseAng = [Math.PI / 2, 0, -Math.PI / 2, Math.PI][gravityDir];
                ang = baseAng + (Math.random() * 0.6 - 0.3);
                spd = Math.random() * 4 + 2;
            } else {
                ang = type === 'land' ? (Math.PI + (Math.random() * Math.PI)) : (Math.random() * Math.PI * 2);
                spd = type === 'land' ? (Math.random() * 5 + 2) : (Math.random() * 3 + 1);
            }

            const svx = Math.cos(ang) * spd;
            let svy = Math.sin(ang) * spd;

